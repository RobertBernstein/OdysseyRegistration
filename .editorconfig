root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csx}]
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8601.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.S125.severity = none    # TODO: Temporary: remove once commented-out test setup code is cleaned up.
dotnet_diagnostic.CA1707.severity = none  # Allow test file names and method names containing "Test" segments with underscores.
dotnet_diagnostic.S1135.severity = none   # Suppress "TODO" comments warning, as we use them for tracking work in progress.
dotnet_diagnostic.MA0026.severity = none  # Suppress Meziantou TODO comment diagnostics across C# files.
dotnet_diagnostic.MA0007.severity = none  # Suppress Meziantou recommendation to flag trailing commas across C# files.

[**/*Test*.cs]
dotnet_diagnostic.CA1707.severity = none # Allow test file names and method names containing "Test" segments with underscores.
[**/*Tests*.cs]
dotnet_diagnostic.CA1707.severity = none # Allow test file names and method names containing "Tests" segments with underscores.
[**/*ModelTests*.cs]
dotnet_diagnostic.MA0048.severity = none # Suppress Meziantou file-name/type-name rule for files containing ModelTests.

[*.cshtml.cs]
dotnet_diagnostic.SA1649.severity = none  # Suppress "File name should match first type name" warning for Razor page code-behind files.
dotnet_diagnostic.MA0048.severity = none  # Suppress Meziantou file-name/type-name rule for Razor Page code-behind files.
[*.cshtml]
dotnet_diagnostic.MA0048.severity = none  # Keep suppression for Razor markup file naming patterns.

[**/Migrations/*.cs]
dotnet_diagnostic.MA0048.severity = none  # Suppress generated EF Core migration naming rule for timestamped migration files.

# Style rules
# The repo deliberately keeps a few style rules as suggestions so the build stays readable and consistent.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Naming conventions
# Keep the team's conventions explicit enough that AI-generated code matches the repository style.
dotnet_naming_rule.interface_should_begin_with_i.severity = error
dotnet_naming_rule.interface_should_begin_with_i.symbols = interface
dotnet_naming_rule.interface_should_begin_with_i.style = begins_with_i

dotnet_naming_rule.async_methods_end_in_async.severity = error
dotnet_naming_rule.async_methods_end_in_async.symbols = any_async_methods
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_symbols.any_async_methods.applicable_kinds = method
dotnet_naming_symbols.any_async_methods.applicable_accessibilities = *
dotnet_naming_symbols.any_async_methods.required_modifiers = async
dotnet_naming_style.end_in_async.required_suffix = Async
dotnet_naming_style.end_in_async.capitalization = pascal_case

# Prefer explicit, readable code.
dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0053.severity = warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion

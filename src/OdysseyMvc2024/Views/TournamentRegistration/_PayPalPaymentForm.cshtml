@model OdysseyMvc2024.ViewData.TournamentRegistration.PayPalPaymentViewData

@{
	string? payPalIpnUrl = Url.Action("PayPalIpn", "TournamentRegistration", null, Context.Request.Scheme);
}

@if (Model.AcceptingPayPal)
{
	<form action="https://www.paypal.com/cgi-bin/webscr" method="post" target="_top" id="payPalPaymentForm">
		<input type="hidden" name="cmd" value="_s-xclick">
		<input type="hidden" name="hosted_button_id" value="NYTRFY3YRCJMJ">
		<input type="hidden" name="notify_url" value="@payPalIpnUrl">
		<input type="hidden" name="custom" id="payPalCustomTeamTournamentId" value="@Model.TeamTournamentId">
		<table>
			<tr><td><input type="hidden" name="on0" value="Online Payment">Online Payment</td></tr>
			<tr>
				<td>
					<select name="os0">
						<option value="Registration Fee -">Tournament Registration Fee &#8211; $100.00 USD</option>
					</select>
				</td>
			</tr>
			<tr><td><input type="hidden" name="on1" value="Team's Tournament ID">Team's Tournament ID</td></tr>
			<tr><td><input type="text" name="os1" id="payPalTeamTournamentId" maxlength="200" value="@Model.TeamTournamentId" required></td></tr>
			<tr><td><input type="hidden" name="on2" value="Coach's Last Name">Coach's Last Name</td></tr>
			<tr><td><input type="text" name="os2" maxlength="200" value="@Model.CoachLastName" required></td></tr>
		</table>
		<input type="hidden" name="currency_code" value="USD">
		<input type="image" src="https://www.paypalobjects.com/en_US/i/btn/btn_paynowCC_LG.gif" border="0" name="submit" alt="PayPal - The safer, easier way to pay online!">
		<img alt="" border="0" src="https://www.paypalobjects.com/en_US/i/scr/pixel.gif" width="1" height="1">
	</form>

	<script>
		$(function () {
			$("#payPalPaymentForm").on("submit", function () {
				$("#payPalCustomTeamTournamentId").val($("#payPalTeamTournamentId").val());
			});
		});
	</script>
}

<?xml version="1.0"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <location path="." inheritInChildApplications="false"
              xdt:Locator="Match(path)"
              xdt:Transform="InsertIfMissing">
        <system.webServer>
            <aspNetCore xdt:Transform="InsertIfMissing">
                <environmentVariables xdt:Transform="InsertIfMissing">
                    <environmentVariable name="ASPNETCORE_ENVIRONMENT"
                                         value="Production"
                                         xdt:Locator="Match(name)"
                                         xdt:Transform="InsertIfMissing" />
                    <environmentVariable name="ConnectionStrings__OdysseyConnection"
                                         value="Data Source=tcp:s06.winhost.com;Initial Catalog=DB_12824_registration;User ID=DB_12824_registration_user;Password=;Pooling=False;Connect Timeout=30;Encrypt=False;Trust Server Certificate=True;Authentication=SqlPassword;Application Name=vscode-mssql;Connect Retry Count=1;Connect Retry Interval=10;Command Timeout=30"
                                         xdt:Locator="Match(name)"
                                         xdt:Transform="InsertIfMissing" />
                </environmentVariables>
            </aspNetCore>
        </system.webServer>
    </location>
</configuration>
